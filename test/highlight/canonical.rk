stack Samples {
~~ <- keyword
~~    ^ type
  f32: value;
~~^ type.builtin
  u8: quality;
}

crunch advance(positions: f32s, velocities: f32s) -> f32s:
~~ <- keyword
~~     ^ function
~~             ^ variable.parameter
  | scaled: f32s <| velocities * <0.5>
~~^ operator.flow
~~                ^^ operator.flow
  | result: f32s <| positions + scaled
  return result
~~^ keyword

rake safe_root(values: f32s) -> f32s:
  tine #valid when values >= <0.0>
~~^ keyword
~~     ^ tag

  through #valid else <0.0> into rooted:
    sqrt(values)

  return sweep:
    | #valid => rooted
    | _      => <0.0>

run scale_values(
  input: pack Samples,
  <count: i64>,
  <scale: f32>
) -> f32:
  for chunk in input using f32s up to <count>:
    let quality: u32s = widen(chunk.quality)
    yield chunk.value * <scale>

crunch stateful(values: f32s) -> f32s:
  accumulator: f32s := values
  accumulator <- shuffle(accumulator, [1, 0, 3, 2])
  inspect(accumulator)
  return accumulator

slow scalar() -> i32:
  let answer = slow { 3 }
~~             ^ keyword
  return answer
