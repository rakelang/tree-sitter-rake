pack Samples {
~~ <- keyword
~~    ^ type
  f32: value;
~~^ type.builtin
  u8: quality;
}

scratch advance(positions: f32s, velocities: f32s) -> f32s:
~~ <- keyword
~~      ^ function
~~              ^ variable.parameter
  | scaled: f32s <| velocities * <0.5>
~~^ operator.flow
~~                ^^ operator.flow
  | result: f32s <| positions + scaled
  result
~~^ variable

rake safe_root(values: f32s) -> f32s:
  tine #valid means values >= <0.0>
~~^ keyword
~~     ^ tag

  through #valid else <0.0> into rooted:
    sqrt(values)

  sweep:
    | #valid => rooted
    | _      => <0.0>

tine #global(values: f32s) means values >= <0.0>
~~ <- keyword
~~    ^ tag
~~            ^ variable.parameter

rake global_root(values: f32s) -> f32s:
  through #global(values) into rooted:
    sqrt(values)
  sweep:
    | #global(values) => rooted
    | #global(values) gaps => <0.0>
~~                    ^ operator

run scale_values(
  input: stack Samples,
  output: stack Samples,
  <scale: f32>
) -> stack Samples:
  let quality: u32s = widen(input.quality)
  tine #positive means input.value > <0.0>
  output with { value: input.value * <scale> } where #positive

run survivors(particles: stack Samples) -> stack Samples:
  compact particles with { value: particles.value + <1.0> } where (#alive and #fast) gaps

scratch stateful(values: f32s) -> f32s:
  accumulator: f32s := values
  accumulator <- shuffle(accumulator, [1, 0, 3, 2])
  inspect(accumulator)
  accumulator

slow scalar() -> i32:
  let answer = slow { 3 }
~~             ^ keyword
  return answer

union foreign_value_t from "values.h" {
~~ <- keyword
~~    ^ type
  i64: i64;
~~^ type.builtin
}

slow integer(value: ptr const foreign_value_t) -> i64:
  return value.i64
~~             ^ property
