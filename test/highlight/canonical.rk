pack Samples {
~~ <- keyword
~~    ^ type
  f32: value;
~~^ type.builtin
  u8: quality;
}

scratch advance(positions: f32s, velocities: f32s) -> f32s:
~~ <- keyword
~~      ^ function
~~              ^ variable.parameter
  | scaled: f32s <| velocities * <0.5>
~~^ operator.flow
~~                ^^ operator.flow
  | result: f32s <| positions + scaled
  result
~~^ variable

rake safe_root(values: f32s) -> f32s:
  tine #valid means values >= <0.0>
~~^ keyword
~~     ^ tag

  through #valid else <0.0> into rooted:
    sqrt(values)

  sweep:
    | #valid => rooted
    | _      => <0.0>

run scale_values(
  input: stack Samples,
  <count: i64>,
  <scale: f32>
) -> f32:
  for chunk in input using f32s up to <count>:
    let quality: u32s = widen(chunk.quality)
    yield chunk.value * <scale>

scratch stateful(values: f32s) -> f32s:
  accumulator: f32s := values
  accumulator <- shuffle(accumulator, [1, 0, 3, 2])
  inspect(accumulator)
  accumulator

slow scalar() -> i32:
  let answer = slow { 3 }
~~             ^ keyword
  return answer

union foreign_value_t from "values.h" {
~~ <- keyword
~~    ^ type
  i64: i64;
~~^ type.builtin
}

slow integer(value: ptr const foreign_value_t) -> i64:
  return value.i64
~~             ^ property
