{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rake",
      "camelcase": "Rake",
      "scope": "source.rake",
      "path": ".",
      "file-types": [
        "rk"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^rake$"
    }
  ],
  "metadata": {
    "version": "0.5.0-beta",
    "license": "MIT",
    "description": "Tree-sitter grammar for Rake, a vector-first SIMD language",
    "authors": [
      {
        "name": "Kieran Rosenberg"
      }
    ],
    "links": {
      "repository": "https://github.com/rakelang/tree-sitter-rake"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
